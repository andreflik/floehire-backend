datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

enum job_status {
  OPEN
  PAUSED
  CLOSED
  ARCHIVED
}

enum job_work_model {
  ONSITE
  HYBRID
  REMOTE
}

enum job_contract_type {
  CLT
  PJ
}

enum job_hire_type {
  REPLACEMENT
  NEW_POSITION
}

model candidates {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  full_name     String   @db.VarChar(150)
  email         String   @unique @db.VarChar(150)
  phone         String?  @db.VarChar(20)
  city          String?  @db.VarChar(100)
  state         String?  @db.Char(2)

  linkedin_url  String?
  github_url    String?
  portfolio_url String?

  password_hash String
  lgpd_consent  Boolean  @default(false)
  created_at    DateTime @default(now())

  candidate_experiences candidate_experiences[]
  candidate_education   candidate_education[]
  job_candidates        job_candidates[]

  candidate_refresh_tokens candidate_refresh_tokens[]
}

model candidate_experiences {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id  String   @db.Uuid
  company       String?
  job_title     String?
  start_date    DateTime?
  end_date      DateTime?
  responsibilities String?
  created_at    DateTime @default(now())

  candidate     candidates @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
}

model candidate_education {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id     String   @db.Uuid

  escolaridade     String?
  curso            String?
  instituicao      String?
  ano_conclusao    String?
  certificacoes    String?
  idiomas          String?

  created_at       DateTime? @default(now())

  candidate        candidates @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
}

model recruiters {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_name  String   @db.VarChar(150)
  email         String   @unique @db.VarChar(150)
  password_hash String
  created_at    DateTime @default(now())

  jobs          jobs[]
  recruiter_refresh_tokens recruiter_refresh_tokens[]
}

model jobs {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recruiter_id  String   @db.Uuid

  title         String   @db.VarChar(150)
  description   String?
  status        job_status @default(OPEN)
  seniority     String?
  work_model    job_work_model?
  contract_type job_contract_type?
  hire_type     job_hire_type?

  city          String?
  state         String?
  salary_min    Int?
  salary_max    Int?

  opened_at     DateTime @default(now())
  deadline      DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  recruiter     recruiters @relation(fields: [recruiter_id], references: [id], onDelete: Cascade)
  stages        job_stages[]
  candidates    job_candidates[]
}


model job_stages {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id      String   @db.Uuid
  name        String
  stage_order Int
  created_at  DateTime @default(now())

  job         jobs @relation(fields: [job_id], references: [id], onDelete: Cascade)
  candidates  job_candidates[]
}


model job_candidates {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id           String   @db.Uuid
  candidate_id     String   @db.Uuid
  current_stage_id String?  @db.Uuid

  rating           Int?
  notes            String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  job           jobs        @relation(fields: [job_id], references: [id], onDelete: Cascade)
  candidate     candidates  @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  current_stage job_stages? @relation(fields: [current_stage_id], references: [id])

  history       job_candidate_history[]
}

model job_candidate_history {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_candidate_id String   @db.Uuid
  from_stage_name  String?
  to_stage_name    String?
  moved_at         DateTime @default(now())
  moved_by         String?
  comment          String?

  job_candidate job_candidates @relation(fields: [job_candidate_id], references: [id], onDelete: Cascade)
}

model password_reset_tokens {
  id         String   @id @default(uuid())
  email      String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
}

model recruiter_refresh_tokens {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recruiter_id String   @db.Uuid
  token        String   @unique
  expires_at   DateTime
  created_at   DateTime @default(now())

  recruiter recruiters @relation(fields: [recruiter_id], references: [id], onDelete: Cascade)

  @@index([recruiter_id])
}

model candidate_refresh_tokens {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id String   @db.Uuid
  token        String   @unique
  expires_at   DateTime
  created_at   DateTime @default(now())

  candidate candidates @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@index([candidate_id])
}
